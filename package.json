{
  "name": "@blckrose/baileys",
  "type": "module",
  "version": "2.0.11",
  "description": "A WebSockets library for interacting with WhatsApp Web",
  "keywords": [
    "whatsapp",
    "automation",
    "baileys",
    "bot",
    "chat",
    "api"
  ],
  "homepage": "https://github.com/Blckrose08/baileys",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blckrose08/baileys.git"
  },
  "license": "MIT",
  "author": "Blckrosé",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "Media/**/*",
    "engine-requirements.js"
  ],
  "scripts": {
    "build": "tsc",
    "gen:protobuf": "sh WAProto/GenerateStatics.sh",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "lint": "tsc && eslint src --ext .js,.ts",
    "prepack": "true",
    "prepare": "true",
    "preinstall": "node ./engine-requirements.js"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "fflate": "latest",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "rosedb": "latest",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "optionalDependencies": {
    "@roamhq/wrtc": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/ws": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.3",
    "protobufjs-cli": "^1.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
